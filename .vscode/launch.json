{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Visualize result",
            "type": "debugpy",
            "request": "launch",
            "program": "plot.py",
            "console": "integratedTerminal",
            "args": [
                "--model=flexible",
                "--checkpoint=kconde_flexible_final.pth"
            ]
        },
        {
            "name": "Train neuralODE",
            "type": "debugpy",
            "request": "launch",
            "program": "train.py",
            "console": "integratedTerminal",
            "args": [
                "--model=flexible", 
                "--epochs=1000",
                "--lr=0.001"
            ]
        },
        {
            "name": "Train kconde_strict",
            "type": "debugpy",
            "request": "launch",
            "program": "train.py",
            "console": "integratedTerminal",
            "args": [
                "--model=strict", 
                "--epochs=1000", 
                "--lr=0.001", 
                "--hidden=12"
            ]
        }
    ]
}